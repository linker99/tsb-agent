### 2.1 核心结构体/类定义

> 📌 **填写要求**：给出完整的 C 结构体定义，每个字段附注释说明用途、约束、默认值。重要结构体须标注 `sizeof` 期望值。

#### 示例：策略节点（内核内部结构）

```c
/**
 * struct httcsec_policy_node - 内核策略链表节点
 *
 * sizeof(struct httcsec_policy_node) == 128（x86_64，含末尾 padding）
 * 对齐要求：8 字节对齐（cache line 友好）
 * 生命周期：模块加载时由 policy_pool 分配，卸载时统一释放
 */
struct httcsec_policy_node {
    /* --- 链表管理（16 字节） --- */
    struct list_head    list;           /* 挂载到全局策略链表 */

    /* --- 标识字段（8 字节） --- */
    uint32_t            id;             /* 策略唯一 ID，单调递增，溢出后回绕 */
    uint8_t             type;           /* POLICY_TYPE_*，见枚举；不可为 0 */
    uint8_t             version;        /* 策略格式版本，当前固定为 1 */
    uint8_t             flags;          /* bit0=强制，bit1=审计，bit2-7 保留(须为0) */
    uint8_t             state;          /* POLICY_STATE_*，见状态机 */

    /* --- 主体/客体（64 字节） --- */
    char                subject[64];    /* 主体路径或标签，'\0' 结尾，UTF-8 */
                                        /* 最大有效长度 63 字节，超出截断并告警 */

    /* --- 完整性摘要（32 字节） --- */
    uint8_t             hash[32];       /* SM3-256 摘要；全零表示不校验 */

    /* --- 时间戳（8 字节） --- */
    int64_t             created_at;     /* 创建时间，ktime_get_real_seconds() */

    /* --- 保留（保持 128 字节对齐，0 字节 padding） --- */
};

/* 编译期大小断言，防止意外字段增删导致 ABI 破坏 */
BUILD_BUG_ON(sizeof(struct httcsec_policy_node) != 128);
```

#### 示例：内核日志环形缓冲区

```c
/**
 * struct httcsec_log_ring - 内核内存日志环形缓冲区
 *
 * 读写并发控制：读侧持 log_spinlock，写侧同样持 log_spinlock
 * 缓冲区大小：LOG_RING_SIZE 条目（默认 1024，见 Kconfig）
 */
struct httcsec_log_ring {
    spinlock_t          lock;           /* 保护以下所有字段 */
    uint32_t            head;           /* 下一个可写位置，[0, LOG_RING_SIZE) */
    uint32_t            tail;           /* 下一个可读位置，[0, LOG_RING_SIZE) */
    uint32_t            count;          /* 当前有效条目数 */
    uint32_t            dropped;        /* 因缓冲区满而丢弃的条目数，累计 */
    struct httcsec_log_entry entries[0];/* 柔性数组，实际大小在 init 时 vmalloc */
};

/**
 * struct httcsec_log_entry - 单条日志条目
 *
 * sizeof == 256（固定大小，方便 ring buffer 下标寻址）
 */
struct httcsec_log_entry {
    int64_t             timestamp_ns;   /* ktime_get_ns()，纳秒精度 */
    uint8_t             level;          /* LOG_LEVEL_*：0=DEBUG,1=INFO,2=WARN,3=ERROR */
    uint8_t             module_id;      /* 见 MODULE_ID_* 枚举 */
    uint16_t            event_id;       /* 见 EVENT_ID_* 枚举，0=普通日志 */
    uint32_t            pid;            /* current->pid */
    uint32_t            tid;            /* current->tgid */
    char                comm[16];       /* current->comm，进程名 */
    char                func[32];       /* __func__，函数名 */
    uint32_t            line;           /* __LINE__ */
    char                msg[188];       /* 日志消息，'\0' 结尾，超长截断 */
                                        /* 188 = 256 - 8 - 1 - 1 - 2 - 4 - 4 - 16 - 32 - 4 */
};

BUILD_BUG_ON(sizeof(struct httcsec_log_entry) != 256);
```

