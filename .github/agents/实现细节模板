### 4.4 降级/熔断配置

> 📌 **填写要求**：描述特性在异常持续发生时的降级行为，给出熔断阈值和恢复条件。

#### 内核模块降级策略

```c
/*
 * 策略引擎降级行为定义
 *
 * 触发条件：策略加载失败（-ENOMEM 或 -ENOENT）且重试耗尽
 * 降级行为：
 *   enforce 模式 → 切换至 audit 模式（放行所有操作，记录审计日志）
 *   audit 模式   → 维持 audit 模式（不降级）
 *   disabled 模式 → 维持 disabled 模式
 *
 * 熔断参数（内核模块全局变量，可通过 sysfs 查看）：
 */
#define POLICY_CIRCUIT_THRESHOLD    5     /* 连续失败 5 次触发熔断 */
#define POLICY_CIRCUIT_HALF_OPEN_S  30    /* 熔断 30s 后进入半开状态，允许一次探测 */

static atomic_t policy_fail_count   = ATOMIC_INIT(0);
static atomic_t policy_circuit_open = ATOMIC_INIT(0); /* 1=熔断中 */

static int policy_load_with_circuit(const char *data, int len)
{
    /* 熔断检查 */
    if (atomic_read(&policy_circuit_open)) {
        DEBUG_MSG(HTTC_TSB_INFO,
                  "[%s] circuit open, skip reload, fallback to audit\n",
                  __func__);
        return -ECONNREFUSED;  /* 熔断中，拒绝请求 */
    }

    int ret = whitelist_policy_reload(data, len);

    if (ret == 0) {
        atomic_set(&policy_fail_count, 0);   /* 成功，重置计数 */
    } else {
        if (atomic_inc_return(&policy_fail_count) >= POLICY_CIRCUIT_THRESHOLD) {
            atomic_set(&policy_circuit_open, 1);  /* 触发熔断 */
            DEBUG_MSG(HTTC_TSB_INFO,
                      "[%s] circuit breaker OPEN after %d failures\n",
                      __func__, POLICY_CIRCUIT_THRESHOLD);
            /* 启动定时器，30s 后尝试半开恢复 */
            mod_timer(&circuit_recover_timer,
                      jiffies + POLICY_CIRCUIT_HALF_OPEN_S * HZ);
        }
    }
    return ret;
}
```

